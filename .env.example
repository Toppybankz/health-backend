# Local development only. Never commit real credentials.
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/health-consultation
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:3000,https://health-consultation-frontend.vercel.app

# Optional administrator provisioning (use only when running create-admin).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# ADMIN_NAME=Platform Administrator
